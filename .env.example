# Live providers (never commit real values)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
TAVILY_API_KEY=

# Use demo for synthetic runs without provider requests.
RESEARCH_MODE=live
REDIS_URL=redis://localhost:6379/0
